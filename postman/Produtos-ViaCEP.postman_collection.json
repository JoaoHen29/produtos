{
  "info": {
    "name": "Produtos - ViaCEP (Atividade M1)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Testes da API de produtos: CRUD e consultas (Aulas 1 a 3) e integracao com a ViaCEP (Aula 4)."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "createdId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. CRUD",
      "item": [
        {
          "name": "Criar produto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set(\"createdId\", pm.response.json().id);",
                  "pm.test(\"Salvou o centro de distribuicao\", function () { pm.expect(pm.response.json().distributionCenter).to.eql(\"Recife\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-User",
                "value": "joao"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Headset HyperX Cloud II\",\n  \"description\": \"Headset gamer 7.1\",\n  \"category\": \"audio\",\n  \"price\": 499.9,\n  \"distributionCenter\": \"Recife\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Listar produtos ativos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ]
            }
          }
        },
        {
          "name": "Atualizar produto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/{{createdId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "{{createdId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Headset HyperX Cloud II\",\n  \"description\": \"Headset gamer 7.1 (promocao)\",\n  \"category\": \"audio\",\n  \"price\": 459.9,\n  \"distributionCenter\": \"Recife\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Inativar produto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 204\", function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{createdId}}/inactivate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "{{createdId}}",
                "inactivate"
              ]
            }
          }
        },
        {
          "name": "Buscar produto inativado (continua no banco, active = false)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Esta inativo\", function () { pm.expect(pm.response.json().active).to.eql(false); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{createdId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "{{createdId}}"
              ]
            }
          }
        }
      ]
    },
